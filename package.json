{
    "name": "sealenv",
    "version": "2.0.0",
    "description": "Validate, type-check, and secure your environment variables — with prototype pollution detection, secret masking, and a CI-ready CLI.",
    "main": "./src/index.js",
    "exports": {
        ".": {
            "import": "./src/index.js",
            "require": "./src/index.js",
            "types": "./src/index.d.ts"
        }
    },
    "types": "./src/index.d.ts",
    "type": "module",
    "engines": {
        "node": ">=18.0.0"
    },
    "bin": {
        "sealenv": "bin/sealenv.js"
    },
    "files": [
        "src/",
        "bin/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "node --test",
        "test:coverage": "node --test --experimental-test-coverage"
    },
    "keywords": [
        "env",
        "dotenv",
        "environment",
        "validation",
        "security",
        "typescript",
        "env-validation",
        "environment-variables",
        "prototype-pollution",
        "secret-masking",
        "env-schema",
        "type-safe-env",
        "ci-cd",
        "config-validation",
        "sealenv"
    ],
    "author": "Anish Nayak",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Anish-530/sealenv.git"
    },
    "homepage": "https://github.com/Anish-530/sealenv#readme",
    "bugs": {
        "url": "https://github.com/Anish-530/sealenv/issues"
    },
    "dependencies": {
        "chalk": "^5.3.0"
    }
}
